# Copie para .env.local e preencha (Supabase: Project Settings > API Keys).
# Use APENAS a chave publishable/anon. Nunca a secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dica com IA (Gemini). Chave só no servidor: NUNCA use o prefixo NEXT_PUBLIC_ nela.
# Crie em https://aistudio.google.com/apikey (camada gratuita). No Vercel: Settings > Environment Variables.
GEMINI_API_KEY=
# Opcional: troque se o modelo padrão (gemini-2.5-flash) for aposentado.
# GEMINI_MODEL=gemini-2.5-flash
